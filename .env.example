# Copy this file to .env and fill in your own values. .env is git-ignored.

# YouTube Data API v3 key (Google Cloud Console) - required
YOUTUBE_API_KEY=your_youtube_api_key_here

REDIS_HOST=localhost
REDIS_PORT=6379

# Base URL encoded in the QR/join link. Use your LAN IP or public domain, not localhost, for phones.
APP_BASE_URL=http://localhost:5173

ROOM_IDLE_HOURS=12
ROOM_CLEANUP_INTERVAL_MS=600000
